# .env.example
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real al repositorio

# ── Perfil de Spring ──────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Base de datos ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5458
DB_NAME=db_ponencias
DB_USERNAME=ms_ponencias
DB_PASSWORD=1324

# ── Servidor ──────────────────────────────────────
SERVER_PORT=8085

# ── URLs de otros microservicios (via API Gateway) ─
MS_AUTH_URL=http://localhost:8080
MS_CONGRESOS_URL=http://localhost:8080
MS_ACTIVIDADES_URL=http://localhost:8080

# ── JWT (para validar tokens en el Gateway) ───────
JWT_SECRET=una_clave_secreta_muy_larga_aqui_minimo_256_bits
